# ============================================
# EasyBarber - Backend Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/barberpro

# Database Pool (optional)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# Database SSL (production)
# DB_CA_CERT=/path/to/ca-certificate.crt

# JWT
JWT_SECRET=
REFRESH_TOKEN_DAYS=30

# Auth provider
# Supabase Auth is mandatory. AUTH_PROVIDER_MODE is deprecated and ignored if present.

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
VERCEL_PROJECT_PREFIX=barberpro-saas-2-0

# Supabase Auth (identity + email confirmation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SUPABASE_REDIRECT_TO=http://localhost:3000/auth/confirm
SUPABASE_AUTH_TIMEOUT_MS=12000

# SMTP (optional; no longer used for authentication verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyBarber <no-reply@easybarber.local>"

# Auth cookies (optional)
# AUTH_COOKIE_DOMAIN=.seudominio.com

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_BASICO=price_xxx
STRIPE_PRICE_ID_PROFISSIONAL=price_xxx
STRIPE_PRICE_ID_PREMIUM=price_xxx
STRIPE_PRICE_ID_BASICO_ONE_TIME=price_xxx
STRIPE_PRICE_ID_PROFISSIONAL_ONE_TIME=price_xxx
STRIPE_PRICE_ID_PREMIUM_ONE_TIME=price_xxx

# Asaas Billing (Pix)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_DESCRIPTION=EasyBarber - Plano {plan} ({barbershop})
ASAAS_TIMEOUT_MS=12000

# WhatsApp Provider (Evolution API v2 externa)
WHATSAPP_PROVIDER=evolution

# Base URL of the Evolution API service (no trailing slash). Ex.: https://evolution.onrender.com
EVOLUTION_API_URL=

# Global API key for the Evolution server
EVOLUTION_API_KEY=

# Webhook BASE URL registered on Evolution v2 (createInstance / setWebhook).
#
# CRITICAL RULES:
#   1. This MUST be the backend (Render) URL — NEVER the frontend (Vercel) URL.
#      The frontend has no /api/v1/whatsapp/webhook routes and will 404 every
#      event Evolution dispatches. Do not reuse NEXT_PUBLIC_API_URL or any
#      *.vercel.app host here.
#   2. This is the BASE only. Evolution v2 with webhook_by_events=true appends
#      `/{event-kebab-case}` itself (connection-update, qrcode-updated,
#      messages-upsert, ...). If you include an event suffix here Evolution
#      duplicates it and you get `.../connection-update/connection-update`
#      404s. Code defensively strips accidental suffixes via
#      normalizeWebhookBaseUrl(), but configure it cleanly.
#   3. No trailing slash.
#
# Production example:
#   BACKEND_WEBHOOK_BASE_URL=https://easybarber-backend.onrender.com/api/v1/whatsapp/webhook
#
# BACKEND_WEBHOOK_BASE_URL is the preferred name. EVOLUTION_WEBHOOK_URL is
# kept as a legacy alias and used as fallback when the new name is empty.
BACKEND_WEBHOOK_BASE_URL=
EVOLUTION_WEBHOOK_URL=

# DEV/TEST ONLY — leave empty in production. Multi-tenant tenants resolve their
# own instanceName from barbershops.whatsapp_instance_name (UNIQUE per tenant).
# If set, this acts as a fallback for non-tenant-scoped legacy code paths only.
EVOLUTION_INSTANCE_NAME=

# DEPRECATED — see DEPLOY.md. Fonte de verdade: barbershops.whatsapp_instance_name.
# Mantido apenas como ponte para fluxos legados (testes/migração).
# Ex.: {"easybarber":"<barbershop_uuid>"}  ou  easybarber=<barbershop_uuid>
WHATSAPP_INSTANCE_BARBERSHOP_MAP=

EVOLUTION_API_TIMEOUT_MS=10000
WHATSAPP_SESSION_TIMEOUT_MS=1800000

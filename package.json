{
  "name": "easybarber-saas",
  "version": "1.0.0",
  "description": "Sistema SaaS completo para gestão de barbearias",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "seed:test-users": "cd backend && npm run seed:test-users",
    "seed:auth-admin": "cd backend && npm run seed:auth-admin",
    "seed:system-users": "cd backend && npm run seed:system-users",
    "migrate:legacy-auth": "cd backend && npm run migrate:legacy-auth"
  },
  "keywords": [
    "barbershop",
    "saas",
    "whatsapp",
    "scheduling",
    "finance"
  ],
  "author": "",
  "license": "Apache-2.0"
}
